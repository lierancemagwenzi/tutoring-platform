{
    "name": "h5p-server",
    "version": "1.0.0",
    "private": true,
    "description": "Dedicated H5P authoring, storage and playback service for the learning platform, built on the official Lumi Education H5P Node.js packages.",
    "main": "build/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsx watch src/index.ts",
        "start": "node build/index.js",
        "fetch-core": "bash scripts/fetch-core.sh",
        "install-content-types": "tsx scripts/install-content-types.ts"
    },
    "dependencies": {
        "@lumieducation/h5p-express": "^10.0.5",
        "@lumieducation/h5p-server": "^10.0.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "express-fileupload": "^1.5.1",
        "multer": "^2.2.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/express-fileupload": "^1.5.1",
        "@types/multer": "^1.4.12",
        "@types/node": "^24.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}
