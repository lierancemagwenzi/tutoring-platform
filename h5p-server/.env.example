# The port this service listens on.
PORT=8080

# The internal base URL this server is reachable at, used server-to-server
# by Laravel's H5PService. In Docker this is the service name; locally it's 127.0.0.1.
H5P_SERVER_URL=http://127.0.0.1:8080

# What the *browser* can reach this server at directly — burned into every
# asset/ajax URL this server generates (H5P core/editor scripts, library
# files, etc.), since <h5p-editor>/<h5p-player> run on Laravel's origin, not
# this one. In Docker this is the published host port, not the service name.
H5P_SERVER_PUBLIC_URL=http://127.0.0.1:8080

# Shared secret checked on every request (both Laravel-to-server and browser-to-server calls).
# Must match H5P_SERVER_API_KEY in the Laravel app's .env.
H5P_SERVER_API_KEY=change-me-in-every-environment

# Where libraries/content/temporary files are stored on disk.
H5P_STORAGE_PATH=./storage

# Where uploaded .h5p packages are temporarily staged during import.
H5P_UPLOADS_PATH=./uploads

# Where the H5P core + editor client assets (fetched via scripts/fetch-core.sh) live.
H5P_CORE_PATH=./h5p/core
H5P_EDITOR_PATH=./h5p/editor

# Comma-separated list of origins allowed to call this server directly from the browser.
CORS_ORIGIN=http://127.0.0.1:8000,http://localhost:5173
